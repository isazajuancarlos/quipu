# Terminación TLS para el servidor OPRF. El servicio escucha solo en
# 127.0.0.1:8787; Nginx pone TLS y protege /admin.
#
# En el bloque http { } (p. ej. /etc/nginx/nginx.conf):
#   limit_req_zone $binary_remote_addr zone=oprf:10m rate=10r/s;

server {
    listen 443 ssl;
    http2 on;
    server_name oprf.tudominio.com;

    ssl_certificate     /etc/letsencrypt/live/oprf.tudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/oprf.tudominio.com/privkey.pem;

    # Solo TLS 1.2 y 1.3. Los anteriores están rotos y ningún cliente legítimo
    # de este servicio los necesita: el SDK habla TLS moderno.
    ssl_protocols TLSv1.2 TLSv1.3;

    # HSTS. El `return 301` de abajo NO basta: la PRIMERA petición de un cliente
    # nuevo viaja en claro y ahí es donde se intercepta. Con esto, el cliente
    # recuerda que este dominio es solo HTTPS y no vuelve a intentarlo en claro.
    #
    # Es la única cabecera de las «de seguridad» que de verdad aplica a una API
    # sin navegador. CSP, X-Frame-Options, Referrer-Policy y Permissions-Policy
    # protegen a un navegador y aquí no tendrían a quién proteger: exigirlas
    # sería alargar la lista sin defender nada.
    #
    # OJO CON `preload`: no se pone a la ligera. Entrar en la lista precargada de
    # los navegadores es difícil de revertir y afecta a TODOS los subdominios.
    # Se deja fuera a propósito; añádelo solo con la decisión tomada.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Que nadie adivine el tipo de contenido. Barato, y aplica también a JSON.
    add_header X-Content-Type-Options "nosniff" always;

    # /admin es la costura con la pasarela de pagos: NO exponer a Internet.
    # Solo desde el backend del portafolio (ajusta la IP permitida).
    location /admin/ {
        allow 127.0.0.1;
        # allow <IP-del-portafolio>;
        deny all;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
    }

    # API pública (evaluate, public-key, healthz).
    location / {
        limit_req zone=oprf burst=20 nodelay;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}

# Redirección 80 -> 443
server {
    listen 80;
    server_name oprf.tudominio.com;
    return 301 https://$host$request_uri;
}
